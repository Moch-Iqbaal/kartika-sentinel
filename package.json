    "test": "node --experimental-strip-types --test src/lib/security/redact.test.ts src/lib/security/ssrf.test.ts src/lib/ingest/url-text.test.ts src/lib/embed/hashing.test.ts src/lib/scoring/risk.test.ts src/lib/model/heuristic.test.ts src/lib/model/stylometry.test.ts src/lib/media/metadata.test.ts src/lib/model/local-indobert.test.ts src/lib/db/ids.test.ts",
