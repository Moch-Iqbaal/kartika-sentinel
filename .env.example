# Salin ke .env.local. Jangan taruh rahasia sungguhan di file contoh ini.

# Demo lokal. Di production biarkan false, kecuali lingkungan latihan.
DEMO_MODE=false
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# HMAC cookie sesi. Wajib di production, minimal 32 karakter acak.
SESSION_SECRET=

# Garam hash pegangan akun. Wajib di production.
HANDLE_HASH_SALT=

# Proses IndoBERT lokal. Hanya 127.0.0.1 atau localhost. Kosongkan token bila tidak dipakai.
LOCAL_HOAX_URL=http://127.0.0.1:43124/classify
LOCAL_MODEL_TOKEN=
HOAX_MODEL_DIR=
HOAX_TOKENIZER_DIR=
HOAX_MODEL_PORT=43124

# Google Fact Check Tools, opsional. Kosong = dilewati.
GOOGLE_FACTCHECK_API_KEY=

# Supabase, opsional. service_role hanya di server. Jangan pernah memakai awalan NEXT_PUBLIC_ untuk service_role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Folder SQLite. Kosong = data/runtime atau /tmp jika folder itu tidak bisa ditulis.
DATA_DIR=
